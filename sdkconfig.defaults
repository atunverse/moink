# 墨印 MoInk (R 系列) sdkconfig defaults — ESP32-C3 SUPERMINI
# 生产配置：日志降级到 Error、深睡唤醒跳过镜像校验、上电校验保留。
# 排障时把 LOG 两行改回 INFO/Debug 即可（不要动 eFuse 级选项）。

# ---- flash 尺寸与模式（沿用 M7 已验证的 DIO 40M）----
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# ---- 控制台走 C3 自带 USB-Serial-JTAG（GPIO18/19）----
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# ---- 日志：生产降级 Error（排障改回 INFO）----
CONFIG_LOG_DEFAULT_LEVEL_ERROR=y
CONFIG_LOG_DEFAULT_LEVEL=1

CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# ---- WiFi 仅 SoftAP（无 STA）；缓冲池保持 IDF 默认 32（不要为了省内存去砍）----
CONFIG_ESP_WIFI_ENABLED=y

# ---- 自定义分区表：双 OTA(1.5MB×2) + 960KB 页面分区 ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- OTA 回滚 ----
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- 启动提速（深睡唤醒跳过二次镜像校验；上电仍保留完整校验）----
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_BOOTLOADER_LOG_LEVEL_ERROR=y
CONFIG_BOOTLOADER_LOG_LEVEL=1

# ---- 定时唤醒精度：RTC 慢时钟为内部 RC，校准周期保持 1024（勿置 0）----
CONFIG_RTC_CLK_SRC_INT_RC=y
CONFIG_RTC_CLK_CAL_CYCLES=1024

# Bluetooth/BLE：刻意不启用（C3 无 PSRAM，NimBLE 会吃光堆并拖垮 SoftAP）。
