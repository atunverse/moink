# ---- PlatformIO / 构建产物 ----
.pio/
.pioenvs/
.piolibdeps/
sdkconfig.old

# ---- 固件/页面产物（可由源码重新生成；发布件走 GitHub Releases）----
*.bin
*.elf
*.map
*.zip
releases/
# flash_kit 是一键刷机工具包，bin 是其内容，保留入库
!flash_kit/*.bin

# ---- 本地备份与历史版本（保留在磁盘，不入库）----
backups/
page/page-R1.0.*.html
!page/page-R1.0.22.html

# ---- 内部过程文档（保留在磁盘，不入库）----
docs/重构方案与架构设计.md
docs/代码审查报告-*.html
docs/会话摘要-*.md
docs/未实施项说明-*.md
docs/问题跟踪.md

# ---- 临时/调试产物 ----
tools/_*
!tools/_exif_test.jpg
*.log
*.tmp
.DS_Store
Thumbs.db

# ---- Python ----
__pycache__/
*.pyc
.venv/

# ---- 编辑器 ----
